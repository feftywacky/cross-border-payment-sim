# services/api — all optional. Secrets stay server-side and are never returned to the browser.
DATA_MODE=live                 # live | fixture (recorded payloads) | record
DATABASE_URL=sqlite:///./data/sim.db
CORS_ORIGINS=http://localhost:3000
WISE_API_TOKEN=                # Wise Platform client-credentials token (partner access required)
RPC_ETHEREUM=                  # override public RPC endpoints, e.g. a keyed provider URL
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_AVALANCHE=
RPC_LINEA=
RPC_SOLANA=
RATE_LIMIT_PER_MINUTE=60
# apps/web
API_ORIGIN=http://127.0.0.1:8000
